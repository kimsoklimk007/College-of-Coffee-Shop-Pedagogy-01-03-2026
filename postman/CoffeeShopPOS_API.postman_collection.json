{
  "info": {
    "name": "Coffee Shop POS API",
    "description": "API Collection for Coffee Shop POS System\n\nBase URL: http://localhost:8000/api\n\n## Order of Testing:\n1. Category (create first - needed for products)\n2. Product (needs category_id)\n3. Product Size (needs product_id)\n4. Discount (needs product_id)\n5. Order (needs product_id, user_id)\n6. Tax\n7. Feedback (needs product_id, user_id)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Category",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/category/create",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "formurlencoded",
              "formurlencoded": [
                {
                  "key": "name",
                  "value": "Coffee",
                  "description": "Category name"
                },
                {
                  "key": "start_date",
                  "value": "2026-01-01",
                  "description": "Start date (optional)"
                },
                {
                  "key": "end_date",
                  "value": "2026-12-31",
                  "description": "End date (optional)"
                }
              ]
            }
          }
        },
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/category/list"
          }
        },
        {
          "name": "Get Category Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/category/1"
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/category/update",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "formurlencoded",
              "formurlencoded": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "Category ID to update"
                },
                {
                  "key": "name",
                  "value": "Updated Coffee",
                  "description": "New name"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/category/delete/1"
          }
        }
      ]
    },
